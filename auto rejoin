local Curse = CFrame.new(
	920.478027, 154.901001, 32838.9648,
	0, 0, -1,
	0, 1, 0,
	1, 0, 0
)

local Flamingo = CFrame.new(
	2284.90918, 15.537796, 910.481323,
	1, 0, 0,
	0, 1, 0,
	0, 0, 1
)

local CurseCheck = Vector3.new(
	-6496.89795,
	89.0350037,
	-116.509003
)

local FlamingoCheck = Vector3.new(
	-286.985962,
	306.13739,
	592.881958
)

local JustTeleported = false
local FruitCache = {}

local function TeleportNearest(fruit, A)
	if not fruit then return "None" end
	if typeof(A) ~= "Vector3" then return "None" end

	local hrp = GetHRP()
	if not hrp then return "None" end

	if FruitCache[fruit] then
		return FruitCache[fruit]
	end

	local dCurse = (CurseCheck - A).Magnitude
	local dFlame = (FlamingoCheck - A).Magnitude
	local dHRP = (hrp.Position - A).Magnitude

	print(
		"HRP:", math.floor(dHRP),
		"| Curse:", math.floor(dCurse),
		"| Flamingo:", math.floor(dFlame)
	)

	local result

	if dCurse < dFlame then
		result = "Curse"
		hrp.CFrame = Curse
	else
		result = "Flamingo"
		hrp.CFrame = Flamingo
	end

	print("Result:", result)
JustTeleported = true
	FruitCache[fruit] = result

	return result
end


local function TweenToFruit(fruit)
	if not fruit or not fruit:FindFirstChild("Handle") then
		return
	end

	local hrp = GetHRP()
	if not hrp then
		return
	end

	if CurrentTween then
		CurrentTween:Cancel()
	end
	TeleportNearest(fruit,fruit.Handle.Position)
	if JustTeleported == true then
		JustTeleported = false
		task.wait(2)
	end
	local targetCF = fruit.Handle.CFrame + Vector3.new(0, fruit.Handle.Size.Y, 0)
	local distance = math.max(0, (hrp.Position - fruit.Handle.Position).Magnitude - 150)

	CurrentTween = TweenService:Create(
		hrp,
		TweenInfo.new(distance / Speed, Enum.EasingStyle.Linear),
		{
			CFrame = targetCF
		}
	)

	CurrentTween:Play()
	CurrentTween.Completed:Wait()

	if fruit and fruit.Parent and fruit:FindFirstChild("Handle") then
		hrp.CFrame = fruit.Handle.CFrame
	end
end

