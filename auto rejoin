local ReportedFruits = {}

local function FindFruit()
	for _, fruit in ipairs(workspace:GetChildren()) do
		if (fruit:IsA("Tool") or fruit:IsA("Model"))
			and fruit.Name:find("Fruit") then

			local handle = fruit:FindFirstChild("Handle")

			if handle and handle:IsA("BasePart") then

				if not ReportedFruits[fruit] then
					ReportedFruits[fruit] = true

					SendWebhook("🍎 Tìm thấy trái", fruit.Name)

					fruit.Destroying:Connect(function()
						ReportedFruits[fruit] = nil
					end)
				end

				return fruit
			end
		end
	end
end

local AllIDs = {}
local Visited = {}
local foundAnything = ""
local actualHour = os.date("!*t").hour

pcall(function()
	AllIDs = HttpService:JSONDecode(readfile("server-hop-temp.json"))
end)

if type(AllIDs) ~= "table" then
	AllIDs = {}
end

if #AllIDs == 0 then
	table.insert(AllIDs, actualHour)

	pcall(function()
		writefile("server-hop-temp.json", HttpService:JSONEncode(AllIDs))
	end)
end

-- Tạo bảng tra cứu nhanh
for i, v in ipairs(AllIDs) do
	if i > 1 then
		Visited[tostring(v)] = true
	end
end

local function Hop()
	local url =
		"https://games.roblox.com/v1/games/" ..
		game.PlaceId ..
		"/servers/Public?sortOrder=Desc&limit=100" ..
		(foundAnything ~= "" and "&cursor=" .. foundAnything or "")

	local startTime = tick()

	local success, Site = pcall(function()
		return HttpService:JSONDecode(game:HttpGet(url))
	end)

	print("API took:", tick() - startTime)

	if not success or not Site or not Site.data then
		warn("Failed to fetch servers")
		return false
	end

	foundAnything = Site.nextPageCursor or ""

	table.sort(Site.data, function(a, b)
		return a.playing > b.playing
	end)

	-- Reset danh sách mỗi giờ
	if tonumber(AllIDs[1]) ~= actualHour then
		pcall(function()
			delfile("server-hop-temp.json")
		end)

		AllIDs = {actualHour}
		Visited = {}
	end

local TargetPlayers = math.random(3, 11)
local Candidates = {}

Status(
	"Looking for "..TargetPlayers.." players",
	Color3.fromRGB(255, 255, 0)
)

for _, server in ipairs(Site.data) do
	local ID = tostring(server.id)

	if server.id ~= game.JobId
		and server.playing == TargetPlayers
		and not Visited[ID] then

		table.insert(Candidates, server)
	end
end

if #Candidates > 0 then
	local server = Candidates[math.random(#Candidates)]
	local ID = tostring(server.id)

	print(("Hop -> %d/%d"):format(
		server.playing,
		server.maxPlayers
	))

	Status(
		("Found server have %d / %d players"):format(
			server.playing,
			server.maxPlayers
		),
		Color3.fromRGB(0, 255, 0)
	)

	table.insert(AllIDs, ID)
	Visited[ID] = true

	pcall(function()
		writefile(
			"server-hop-temp.json",
			HttpService:JSONEncode(AllIDs)
		)
	end)

	ReplicatedStorage.__ServerBrowser:InvokeServer(
		"teleport",
		server.id
	)

	return true
end

Status(
	"No "..TargetPlayers.." player server found",
	Color3.fromRGB(255, 0, 0)
)

return false
end
