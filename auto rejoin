function NoClip()


	for a,b in pairs(workspace:GetChildren()) do
		if b.Name == player.Name then

			for i,v in pairs(workspace[player.Name]:GetChildren()) do
				if v:IsA("BasePart") then	
					v.CanCollide = false
				end
			end
		end
	end				
end

