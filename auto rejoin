local function antiSit(char)
    local hum = char:WaitForChild("Humanoid")

    while hum.Parent do
        if hum.Sit == true then
            hum.Sit = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
        task.wait(0.1)
    end
end

