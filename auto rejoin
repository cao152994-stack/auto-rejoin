-- TWEEN FUNCTION
-----------------------
local Speed = 300
local function TweenTo(cf, pos)
	local distance = (hrp.Position - pos).Magnitude
	local timetw = math.max((distance - 150) / Speed, 0)

	BodyVelocity(hrp)
	NoClip()

	local tween = TweenService:Create(
		hrp,
		TweenInfo.new(timetw, Enum.EasingStyle.Linear),
		{
			CFrame = cf
		}
	)

	tween:Play()
	return tween
end

